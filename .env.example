APP_NAME=Ransomware Analysis Backend
APP_ENV=production
LOG_LEVEL=INFO
DATA_DIR=/app/data
MODEL_DIR=/app/ml/models
XGBOOST_MODEL_PATH=/app/ml/models/xgboost_model.json
LLM_MODEL=gpt-5.2
OPENAI_API_KEY=
DATABASE_URL=sqlite:////app/data/app.db
NETGUARDIAN_API_KEY=
MAX_UPLOAD_SIZE_BYTES=104857600

AWS_REGION=ap-southeast-2
NG_WINDOWS_AMI_ID=ami-xxxxxxxxxxxxxxxxx
NG_WINDOWS_KEY_NAME=netguardian-key
NG_WINDOWS_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
NG_WINDOWS_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxxxxxxx
NG_WINDOWS_INSTANCE_TYPE=t3.small
NG_WINDOWS_SSH_USERNAME=Administrator
NG_WINDOWS_SSH_PASSWORD=
NG_WINDOWS_REMOTE_SAMPLE_DIR=C:\NetGuardian\Samples
SANDBOX_RUNTIME_SECONDS=300
SANDBOX_MAX_ACTIVE_SESSIONS=1
SANDBOX_SSH_WAIT_SECONDS=900
SANDBOX_LOG_WAIT_SECONDS=60
SANDBOX_LOG_POLL_INTERVAL_SECONDS=5
SANDBOX_TERMINATE_WAIT=true
